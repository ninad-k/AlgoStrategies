// SPDX-License-Identifier: MPL-2.0
// Author: Ninad Kulkarni
//
// Strategy: trade the Swing Structure Forecast.
//   - Detect swing pivots over `swingLen` bars.
//   - On every confirmed direction flip, record the just-completed swing leg
//     (% size + bar duration) and aggregate the last N legs into a forecast.
//   - Bull flip → long; bear flip → short.
//   - SL = opposing pivot ± ATR buffer; TP = projected target (optional fib mult).
// Visual layer matches the standalone indicator: S/R zones, projection beam,
// target box, path-marker dots, fib extensions.

//@version=6
strategy("Swing Structure Forecast — Strategy",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 100,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.02,
     max_labels_count     = 500,
     max_boxes_count      = 500,
     max_lines_count      = 500,
     max_bars_back        = 5000)

// ── Inputs ─────────────────────────────────────────────────────────

GRP_DETECT  = "Detection"
swingLen    = input.int(16, "Swing Length", minval = 10, group = GRP_DETECT)

GRP_SR      = "Support / Resistance"
showLevels  = input.bool(true, "Show S/R Levels",  group = GRP_SR)
zoneATR     = input.float(0.30, "Zone Width (ATR)", minval = 0.05, maxval = 0.5, step = 0.05, group = GRP_SR)
maxAge      = input.int(300, "Max Level Age (bars)", minval = 30, group = GRP_SR)

GRP_PROJ    = "Forecast"
samples     = input.int(20, "Samples", minval = 3, maxval = 20, group = GRP_PROJ)
method      = input.string("Weighted", "Method", ["Weighted", "Average", "Median"], group = GRP_PROJ)
minSamples  = input.int(3, "Min Samples Before Trading", minval = 2, group = GRP_PROJ)
fwdBars     = input.int(5,  "Forecast Bars", minval = 5, group = GRP_PROJ)
showBeam    = input.bool(true, "Projection Beam", group = GRP_PROJ)
showTarget  = input.bool(true, "Target Zone",     group = GRP_PROJ)
showDots    = input.bool(true, "Path Markers",    group = GRP_PROJ)
showFibs    = input.bool(true, "Fib Extensions",  group = GRP_PROJ)
fib1On      = input.bool(true,  "Level 1", group = GRP_PROJ, inline = "f1")
fib1Val     = input.float(1.000, "",       group = GRP_PROJ, inline = "f1", minval = 0.001, step = 0.001)
fib2On      = input.bool(true,  "Level 2", group = GRP_PROJ, inline = "f2")
fib2Val     = input.float(1.272, "",       group = GRP_PROJ, inline = "f2", minval = 0.001, step = 0.001)
fib3On      = input.bool(true,  "Level 3", group = GRP_PROJ, inline = "f3")
fib3Val     = input.float(1.618, "",       group = GRP_PROJ, inline = "f3", minval = 0.001, step = 0.001)
fib4On      = input.bool(false, "Level 4", group = GRP_PROJ, inline = "f4")
fib4Val     = input.float(2.000, "",       group = GRP_PROJ, inline = "f4", minval = 0.001, step = 0.001)
fib5On      = input.bool(false, "Level 5", group = GRP_PROJ, inline = "f5")
fib5Val     = input.float(2.618, "",       group = GRP_PROJ, inline = "f5", minval = 0.001, step = 0.001)

GRP_RISK    = "Risk / Exits"
riskPct     = input.float(1.0, "Risk % per Trade", minval = 0.05, maxval = 5.0, step = 0.05, group = GRP_RISK)
slAtrMult   = input.float(1.0, "SL ATR Buffer (× ATR200)", minval = 0.0, step = 0.1, group = GRP_RISK)
useFibTP    = input.bool(false, "Use Fib TP Multiple", group = GRP_RISK)
fibTPLevel  = input.float(1.000, "Fib TP Level", minval = 0.1, step = 0.001, group = GRP_RISK,
     tooltip = "1.0 = projected target. 1.272 / 1.618 push TP further along the same direction.")
maxBarsHold = input.int(0, "Max Bars in Trade (0 = off)", minval = 0, group = GRP_RISK)
reverseFlip = input.bool(true, "Reverse on Opposite Flip", group = GRP_RISK)

GRP_DIR     = "Direction Toggles"
allowLong   = input.bool(true,  "Allow Long",  group = GRP_DIR)
allowShort  = input.bool(true,  "Allow Short", group = GRP_DIR)

GRP_VIS     = "Visualization"
showPivots  = input.bool(true, "Plot Pivots", group = GRP_VIS)

GRP_CLR     = "Colors"
bullClr     = input.color(#00ff00, "Bull",     inline = "c",  group = GRP_CLR)
bearClr     = input.color(#ff0000, "Bear",     inline = "c",  group = GRP_CLR)
projClr     = input.color(#42a5f5, "Forecast", inline = "c2", group = GRP_CLR)
fibClr      = input.color(#ffeb3b, "Fib",      inline = "c2", group = GRP_CLR)

CLEAR = color.new(color.black, 100)

// ── Types ──────────────────────────────────────────────────────────

type Pivot
    float price
    int   idx

type SRZone
    float price
    int   startIdx
    bool  isResistance
    bool  broken
    box   outerBox
    box   innerBox
    line  lvlLine

// ── State ──────────────────────────────────────────────────────────

var hi  = Pivot.new(na, na)
var lo  = Pivot.new(na, na)
var bool dir = false

var srZones = array.new<SRZone>()
var pcts    = array.new<float>()
var durs    = array.new<float>()

var int   entryBar  = na
var float lastEntry = na
var float lastSL    = na
var float lastTP    = na

// Forecast objects refreshed on the latest bar
var polyline beamOuter  = na
var polyline beamMid    = na
var polyline beamInner  = na
var line     centerLine = na
var box      tgtOuter   = na
var box      tgtInner   = na
var label    tgtLabel   = na
var label[]  dots       = array.new<label>()
var line[]   fibLines   = array.new<line>()
var label[]  fibLabels  = array.new<label>()

atr = ta.atr(200)

// ── Helpers ────────────────────────────────────────────────────────

// Smoothstep-eased cone polyline (forward then back along centerline).
buildBeamPts(int oIdx, int tIdx, float orig, float tgt, float bHalf, float mult, int steps) =>
    pts = array.new<chart.point>()
    for s = 0 to steps
        t     = s / float(steps)
        eased = t * t * (3.0 - 2.0 * t)
        x     = oIdx + int((tIdx - oIdx) * t)
        yc    = orig + (tgt - orig) * eased
        sp    = bHalf * mult * eased
        pts.push(chart.point.from_index(x, yc + sp))
    for s = steps to 0
        t     = s / float(steps)
        eased = t * t * (3.0 - 2.0 * t)
        x     = oIdx + int((tIdx - oIdx) * t)
        yc    = orig + (tgt - orig) * eased
        sp    = bHalf * mult * eased
        pts.push(chart.point.from_index(x, yc - sp))
    pts

forecastPct(array<float> a) =>
    n   = a.size()
    out = 0.0
    if n > 0
        if method == "Weighted"
            tw = 0.0, ws = 0.0
            for i = 0 to n - 1
                w   = i + 1.0
                ws += a.get(i) * w
                tw += w
            out := ws / tw
        else if method == "Median"
            out := a.median()
        else
            out := a.avg()
    out

// Lots/units that risk `riskPct` of equity given a stop distance in price.
qtyForRisk(float slDist) =>
    riskMoney = strategy.equity * (riskPct / 100.0)
    riskMoney / math.max(slDist, syminfo.mintick)

// ── Pivot detection (rolling highest/lowest over swingLen) ─────────

H = ta.highest(high, swingLen)
L = ta.lowest(low,   swingLen)

if high == H
    dir := true
if low  == L
    dir := false

// Confirm pivot one bar after the extreme: previous bar held the extreme,
// current bar broke away from it.
if high[1] == H[1] and high < H
    hi.idx   := bar_index[1]
    hi.price := high[1]
    if showPivots
        label.new(hi.idx, hi.price, "H", style = label.style_label_down, color = color.new(bearClr, 70), textcolor = color.white, size = size.tiny)

if low[1] == L[1] and low > L
    lo.idx   := bar_index[1]
    lo.price := low[1]
    if showPivots
        label.new(lo.idx, lo.price, "L", style = label.style_label_up, color = color.new(bullClr, 70), textcolor = color.white, size = size.tiny)

// ── Direction flip → record swing leg, draw S/R zone, decide trade ─

if dir != dir[1] and not na(hi.price) and not na(lo.price)
    pct  = not dir ? (hi.price - lo.price) / lo.price * 100 : (lo.price - hi.price) / hi.price * 100
    bars = math.abs(hi.idx - lo.idx)

    pcts.push(math.abs(pct))
    durs.push(bars)
    if pcts.size() > samples
        pcts.shift()
        durs.shift()

    // S/R zone for the prior pivot
    if showLevels
        zWidth = atr * zoneATR
        if dir
            // flipped to bull → prior pivot was a swing high (resistance)
            z = SRZone.new()
            z.price        := hi.price
            z.startIdx     := hi.idx
            z.isResistance := true
            z.broken       := false
            z.outerBox     := box.new(hi.idx, hi.price + zWidth,        bar_index + 5, hi.price, border_color = CLEAR, bgcolor = color.new(bearClr, 90))
            z.innerBox     := box.new(hi.idx, hi.price + zWidth * 0.35, bar_index + 5, hi.price, border_color = CLEAR, bgcolor = color.new(bearClr, 82))
            z.lvlLine      := line.new(hi.idx, hi.price, bar_index + 5, hi.price, color = color.new(bearClr, 45), width = 1)
            srZones.push(z)
        else
            // flipped to bear → prior pivot was a swing low (support)
            z = SRZone.new()
            z.price        := lo.price
            z.startIdx     := lo.idx
            z.isResistance := false
            z.broken       := false
            z.outerBox     := box.new(lo.idx, lo.price, bar_index + 5, lo.price - zWidth,        border_color = CLEAR, bgcolor = color.new(bullClr, 90))
            z.innerBox     := box.new(lo.idx, lo.price, bar_index + 5, lo.price - zWidth * 0.35, border_color = CLEAR, bgcolor = color.new(bullClr, 82))
            z.lvlLine      := line.new(lo.idx, lo.price, bar_index + 5, lo.price, color = color.new(bullClr, 45), width = 1)
            srZones.push(z)

    // Trade decision once enough swings have been observed
    if pcts.size() >= minSamples
        fPct = forecastPct(pcts)

        if fPct > 0.0
            wantLong  = dir       and allowLong
            wantShort = (not dir) and allowShort

            if wantLong or wantShort
                origin   = wantLong ? lo.price : hi.price
                rawTgt   = wantLong ? origin * (1.0 + fPct / 100.0) : origin * (1.0 - fPct / 100.0)
                tpPrice  = useFibTP ? origin + (rawTgt - origin) * fibTPLevel : rawTgt
                opposing = wantLong ? lo.price : hi.price
                slPrice  = wantLong ? opposing - atr * slAtrMult : opposing + atr * slAtrMult

                entry  = close
                slDist = math.abs(entry - slPrice)

                if slDist > syminfo.mintick * 5
                    qty     = qtyForRisk(slDist)
                    inLong  = strategy.position_size > 0
                    inShort = strategy.position_size < 0

                    if reverseFlip and ((wantLong and inShort) or (wantShort and inLong))
                        strategy.close_all(comment = "flip-close")

                    geomOK = wantLong  ? (tpPrice > entry and slPrice < entry) :
                                         (tpPrice < entry and slPrice > entry)

                    if geomOK and not (wantLong and inLong) and not (wantShort and inShort)
                        if wantLong
                            strategy.entry("L", strategy.long, qty = qty, comment = "ssf-long")
                            strategy.exit ("L-x", "L", stop = slPrice, limit = tpPrice)
                        if wantShort
                            strategy.entry("S", strategy.short, qty = qty, comment = "ssf-short")
                            strategy.exit ("S-x", "S", stop = slPrice, limit = tpPrice)

                        entryBar  := bar_index
                        lastEntry := entry
                        lastSL    := slPrice
                        lastTP    := tpPrice

// ── S/R zone aging / break detection / cleanup ─────────────────────

if srZones.size() > 0
    for i = srZones.size() - 1 to 0
        z   = srZones.get(i)
        age = bar_index - z.startIdx
        clr = z.isResistance ? bearClr : bullClr

        if not z.broken
            brokeUp   =  z.isResistance and close > z.price
            brokeDown = not z.isResistance and close < z.price
            if brokeUp or brokeDown
                z.broken := true
                line.set_style(z.lvlLine, line.style_dotted)
                line.set_color(z.lvlLine, color.new(clr, 80))
                box.set_bgcolor(z.outerBox, color.new(clr, 96))
                box.set_bgcolor(z.innerBox, color.new(clr, 94))

        if age > maxAge or (z.broken and age > 30)
            box.delete(z.outerBox)
            box.delete(z.innerBox)
            line.delete(z.lvlLine)
            srZones.remove(i)
            continue

        if not z.broken
            // Linear age fade — older un-broken zones look thinner.
            fade   = math.min(float(age) / float(maxAge), 1.0)
            outerT = int(90.0 + 10.0 * fade)
            innerT = int(82.0 + 18.0 * fade)
            lineT  = int(45.0 + 55.0 * fade)
            box.set_right(z.outerBox, bar_index + 5)
            box.set_right(z.innerBox, bar_index + 5)
            line.set_x2(z.lvlLine, bar_index + 5)
            box.set_bgcolor(z.outerBox, color.new(clr, outerT))
            box.set_bgcolor(z.innerBox, color.new(clr, innerT))
            line.set_color(z.lvlLine, color.new(clr, lineT))

// ── Forecast renderer (latest bar only) ────────────────────────────

if barstate.islast and pcts.size() >= 2
    // Wipe the previous render
    beamOuter.delete()
    beamMid.delete()
    beamInner.delete()
    centerLine.delete()
    tgtOuter.delete()
    tgtInner.delete()
    tgtLabel.delete()
    for d in dots
        d.delete()
    dots.clear()
    for fl in fibLines
        fl.delete()
    fibLines.clear()
    for flb in fibLabels
        flb.delete()
    fibLabels.clear()

    // Aggregate per chosen method
    fPct  = 0.0
    fBars = 0.0
    if method == "Weighted"
        tw = 0.0, wp = 0.0, wb = 0.0
        for i = 0 to pcts.size() - 1
            w   = i + 1.0
            wp += pcts.get(i) * w
            wb += durs.get(i) * w
            tw += w
        fPct  := wp / tw
        fBars := wb / tw
    else if method == "Median"
        fPct  := pcts.median()
        fBars := durs.median()
    else
        fPct  := pcts.avg()
        fBars := durs.avg()

    // Std-dev of swing % around the forecast — drives beam/target width
    variance = 0.0
    for i = 0 to pcts.size() - 1
        d = pcts.get(i) - fPct
        variance += d * d
    stdDev = math.sqrt(variance / pcts.size())

    isBear    = not dir
    origin    = isBear ? hi.price : lo.price
    originIdx = isBear ? hi.idx   : lo.idx
    target    = isBear ? origin * (1.0 - fPct / 100.0) : origin * (1.0 + fPct / 100.0)
    targetIdx = bar_index + fwdBars
    bandHalf  = math.max(origin * stdDev / 100.0, atr * 0.1)

    // Layered beam: outer (1.5×), mid (1.0×), inner (0.5×) of band-half
    if showBeam and not na(originIdx)
        outerPts = buildBeamPts(originIdx, targetIdx, origin, target, bandHalf, 1.5, 12)
        midPts   = buildBeamPts(originIdx, targetIdx, origin, target, bandHalf, 1.0, 12)
        innerPts = buildBeamPts(originIdx, targetIdx, origin, target, bandHalf, 0.5, 12)
        beamOuter := polyline.new(outerPts, false, true, line_color = CLEAR,                 fill_color = color.new(projClr, 93))
        beamMid   := polyline.new(midPts,   false, true, line_color = color.new(projClr, 80), fill_color = color.new(projClr, 87))
        beamInner := polyline.new(innerPts, false, true, line_color = CLEAR,                 fill_color = color.new(projClr, 78))

    if not na(originIdx)
        centerLine := line.new(originIdx, origin, targetIdx, target, color = color.new(projClr, 30), width = 1, style = line.style_dashed)

    if showDots and not na(originIdx)
        for s = 1 to 4
            t     = s / 5.0
            eased = t * t * (3.0 - 2.0 * t)
            x     = originIdx + int((targetIdx - originIdx) * t)
            y     = origin + (target - origin) * eased
            tr    = int(25.0 + 45.0 * (1.0 - t))
            dots.push(label.new(x, y, "●", style = label.style_none, textcolor = color.new(projClr, tr), size = size.tiny))

    if showTarget
        tgtTop = target + bandHalf * 0.6
        tgtBot = target - bandHalf * 0.6
        tgtOuter := box.new(targetIdx - 3, tgtTop + bandHalf * 0.3, targetIdx + 6, tgtBot - bandHalf * 0.3, border_color = CLEAR, bgcolor = color.new(projClr, 90))
        tgtInner := box.new(targetIdx - 2, tgtTop, targetIdx + 5, tgtBot, border_color = color.new(projClr, 40), border_width = 1, bgcolor = color.new(projClr, 80))
        sign     = isBear ? "▼ " : "▲ "
        tgtLabel := label.new(targetIdx + 6, target, sign + str.tostring(fPct, "#.##") + "%\n" + str.tostring(target, format.mintick), style = label.style_label_left, color = color.new(projClr, 15), textcolor = color.white, size = size.normal)

    if showFibs
        fullMove  = target - origin
        fibActive = array.from(fib1On,  fib2On,  fib3On,  fib4On,  fib5On)
        fibVals   = array.from(fib1Val, fib2Val, fib3Val, fib4Val, fib5Val)
        fibAlphas = array.from(30,      45,      30,      55,      65)
        for i = 0 to fibVals.size() - 1
            if not fibActive.get(i)
                continue
            ratio    = fibVals.get(i)
            fibPrice = origin + fullMove * ratio
            alpha    = fibAlphas.get(i)
            fibLines.push(line.new(bar_index, fibPrice, targetIdx + 20, fibPrice, color = color.new(fibClr, alpha), width = 1, style = ratio == 1.0 ? line.style_solid : line.style_dashed))
            fibLabels.push(label.new(targetIdx + 22, fibPrice, str.tostring(ratio, "#.###") + "  " + str.tostring(fibPrice, format.mintick), style = label.style_label_left, color = color.new(fibClr, 80), textcolor = color.new(fibClr, 10), size = size.small))

// ── Time-based exit ────────────────────────────────────────────────

if maxBarsHold > 0 and strategy.position_size != 0 and not na(entryBar)
    if bar_index - entryBar >= maxBarsHold
        strategy.close_all(comment = "time-stop")
        entryBar := na

if strategy.position_size == 0
    entryBar  := na
    lastEntry := na
    lastSL    := na
    lastTP    := na

// ── Live entry/SL/TP markers ───────────────────────────────────────

plot(strategy.position_size != 0 ? lastEntry : na, "Entry", color = color.new(color.aqua, 0), style = plot.style_circles, linewidth = 2)
plot(strategy.position_size != 0 ? lastSL    : na, "SL",    color = color.new(color.red,  0), style = plot.style_circles, linewidth = 2)
plot(strategy.position_size != 0 ? lastTP    : na, "TP",    color = color.new(color.lime, 0), style = plot.style_circles, linewidth = 2)

// ── Alerts ─────────────────────────────────────────────────────────

alertcondition(dir != dir[1] and dir,     title = "Long Signal",  message = "{{ticker}} SSF long signal")
alertcondition(dir != dir[1] and not dir, title = "Short Signal", message = "{{ticker}} SSF short signal")
