# AI Provider — set ONE of the following (Groq is free, no credit card needed)
# Groq (free): https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (paid): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Priority: GROQ_API_KEY is used first if both are set

# Optional: NewsAPI for broader news coverage (https://newsapi.org - free tier available)
NEWS_API_KEY=your_newsapi_key_here

# Optional: Alpha Vantage for additional market data (https://alphavantage.co - free tier)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Server settings
HOST=0.0.0.0
PORT=8000

# Analysis cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# Claude model to use
CLAUDE_MODEL=claude-opus-4-6

# Max news articles to include per symbol analysis
MAX_NEWS_ARTICLES=10
