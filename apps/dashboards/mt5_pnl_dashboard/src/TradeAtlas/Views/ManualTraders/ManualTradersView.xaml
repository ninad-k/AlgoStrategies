<UserControl x:Class="TradeAtlas.Views.ManualTraders.ManualTradersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TradeAtlas.ViewModels"
             xmlns:conv="clr-namespace:TradeAtlas.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ManualTradersViewModel, IsDesignTimeCreatable=False}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <conv:PnlToColorConverter x:Key="PnlToColorConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Add Trader" Command="{Binding AddTraderCommand}" Margin="2" />
            <Button Content="Edit" Command="{Binding EditTraderCommand}" Margin="2" />
            <Button Content="Delete" Command="{Binding DeleteTraderCommand}" Margin="2" />
            <Separator />
            <Button Content="Refresh" Command="{Binding LoadTradersCommand}" Margin="2" />
        </ToolBar>

        <!-- Traders Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Traders}"
                  SelectedItem="{Binding SelectedTrader}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="4" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="120" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Performance Detail -->
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="8" MinHeight="60">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Selected Trader P&amp;L: " FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedTraderPnl, StringFormat='{}{0:F2}'}"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{Binding SelectedTraderPnl, Converter={StaticResource PnlToColorConverter}}" />
                <TextBlock Text="  Win Rate: " FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{Binding SelectedTraderWinRate, StringFormat='{}{0:P1}'}"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
