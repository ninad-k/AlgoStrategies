# Optional overrides for the TradingView MCP server.
# Copy this file to .env and edit as needed.

# Chrome DevTools Protocol endpoint TradingView Desktop will be polled on.
TVMCP_CDP_HOST=localhost
TVMCP_CDP_PORT=9222

# Path to the rules.json that drives the morning_brief workflow.
# Defaults to ./rules.json next to the package working directory.
# TVMCP_RULES_PATH=/absolute/path/to/rules.json

# Directory where structured logs and morning-brief sessions are written.
# Defaults to ~/.tradingview-mcp-ninad
# TVMCP_STATE_DIR=~/.tradingview-mcp-ninad
