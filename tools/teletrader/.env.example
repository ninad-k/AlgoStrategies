# TeleTrader Configuration
# Copy to .env and fill in your values

# Mode: "local" (default) or "aws"
TELETRADER_MODE=local

# Local API
TELETRADER_API_PORT=8100

# Telegram Bot (for sending signals directly to the bot)
TELETRADER_TELEGRAM_BOT_TOKEN=your_bot_token
TELETRADER_TELEGRAM_CHAT_ID=your_chat_id

# Channel Forwarder (auto-copy signals from Telegram channels)
# Get API ID and Hash from https://my.telegram.org/apps
TELETRADER_TELEGRAM_API_ID=your_api_id
TELETRADER_TELEGRAM_API_HASH=your_api_hash
TELETRADER_TELEGRAM_PHONE=+919876543210
TELETRADER_FORWARDER_CHANNELS=channel1,channel2

# AWS (only used when mode=aws)
TELETRADER_AWS_REGION=us-east-1
TELETRADER_DYNAMODB_TABLE=teletrader-signals
