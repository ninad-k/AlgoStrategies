{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mt5-trade-segregator/rules.schema.json",
  "title": "TradeSegregator rules",
  "type": "object",
  "required": ["version", "categories", "uncategorizedId"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "uncategorizedId": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "match", "conditions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "match": { "type": "string", "enum": ["all", "any"] },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "op"],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "profit",
                    "volume",
                    "magic",
                    "duration_seconds",
                    "duration_minutes",
                    "deal_type",
                    "entry"
                  ]
                },
                "op": {
                  "type": "string",
                  "enum": ["eq", "neq", "lt", "lte", "gt", "gte", "between", "contains"]
                },
                "value": {},
                "value2": {},
                "min": {},
                "max": {}
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "op": { "const": "between" } },
                    "required": ["op"]
                  },
                  "then": { "required": ["min", "max"] }
                },
                {
                  "if": {
                    "properties": { "op": { "const": "contains" } },
                    "required": ["op"]
                  },
                  "then": { "required": ["value"] }
                },
                {
                  "if": {
                    "properties": { "op": { "not": { "enum": ["between", "contains"] } } },
                    "required": ["op"]
                  },
                  "then": { "required": ["value"] }
                }
              ]
            }
          }
        }
      }
    }
  }
}
