# PineConnector Configuration

# Webhook authentication token (required for production)
WEBHOOK_TOKEN=your_secret_token_here

# Server
HOST=0.0.0.0
PORT=8003

# ZMQ addresses (default: localhost)
ZMQ_SIGNAL_ADDR=tcp://127.0.0.1:5555
ZMQ_COMMAND_ADDR=tcp://127.0.0.1:5556
ZMQ_RESULT_ADDR=tcp://127.0.0.1:5557
ZMQ_STATE_ADDR=tcp://127.0.0.1:5558

# MT5 bridge mode: "python" or "mql5"
MT5_BRIDGE_MODE=python

# MT5 connection (for Python bridge mode)
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Database backend: "sqlite" or "postgresql"
DB_BACKEND=sqlite
# PostgreSQL DSN (only if DB_BACKEND=postgresql)
PG_DSN=postgresql://user:pass@localhost:5432/pineconnector

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dry run mode (no real trades)
DRY_RUN=false
