<UserControl x:Class="Mt5PnlDashboard.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mt5PnlDashboard.ViewModels"
             xmlns:conv="clr-namespace:Mt5PnlDashboard.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel, IsDesignTimeCreatable=False}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <conv:PnlToColorConverter x:Key="PnlToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="4">
            <!-- Total P&L -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total P&amp;L" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding TotalPnl, StringFormat='{}{0:C2}'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{Binding TotalPnl, Converter={StaticResource PnlToColorConverter}}" />
                </StackPanel>
            </Border>
            <!-- Win Rate -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="Win Rate" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding WinRate, StringFormat='{}{0:P1}'}"
                               FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- Profit Factor -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="Profit Factor" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding ProfitFactor, StringFormat='{}{0:F2}'}"
                               FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- Max Drawdown -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="Max Drawdown" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding MaxDrawdown, StringFormat='{}{0:P2}'}"
                               FontSize="24" FontWeight="Bold" Foreground="Red" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="4">
            <TabItem Header="Overview">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Chart Placeholder -->
                    <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Margin="4">
                        <TextBlock Text="Equity Curve Chart (placeholder)"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic" />
                    </Border>

                    <!-- Recent Trades Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Trades}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="4" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="80" />
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="80" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="60" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding Volume, StringFormat='{}{0:F2}'}" Width="60" />
                            <DataGridTextColumn Header="Entry Time" Binding="{Binding EntryTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130" />
                            <DataGridTextColumn Header="Exit Time" Binding="{Binding ExitTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130" />
                            <DataGridTextColumn Header="P&amp;L" Binding="{Binding ProfitLoss, StringFormat='{}{0:F2}'}" Width="80" />
                            <DataGridTextColumn Header="Strategy" Binding="{Binding StrategyName}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding CategorizationStatus}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="By Account">
                <TextBlock Text="Account breakdown view (placeholder)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic" />
            </TabItem>
            <TabItem Header="By Symbol">
                <TextBlock Text="Symbol breakdown view (placeholder)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic" />
            </TabItem>
            <TabItem Header="By Time">
                <TextBlock Text="Time-based analysis view (placeholder)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic" />
            </TabItem>
            <TabItem Header="Manual vs Auto">
                <TextBlock Text="Manual vs Automated comparison view (placeholder)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic" />
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..." FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
