{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStrings": {
      "Sqlite": "Data Source=mt5_pnl_dashboard.db",
      "PostgreSql": "Host=localhost;Database=mt5_pnl;Username=postgres;Password=password"
    }
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "UseSsl": true
  },
  "Mt5Accounts": [],
  "ReportSchedule": {
    "Enabled": false,
    "CronExpression": "0 0 * * MON",
    "ReportTypes": ["Weekly"],
    "EmailRecipients": []
  },
  "AlertThresholds": {
    "MaxDrawdownPercent": 10.0,
    "DailyLossLimit": 500.0,
    "ConsecutiveLossCount": 5
  },
  "ThemeName": "Light",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/mt5_pnl_dashboard-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
