//@version=5
strategy("Gold Fib Hedge Strategy", shorttitle="GFH Strategy",
         overlay=true, default_qty_type=strategy.fixed,
         default_qty_value=1, initial_capital=10000, currency=currency.USD,
         commission_type=strategy.commission.percent, commission_value=0.01,
         slippage=3, calc_on_every_tick=false, pyramiding=2,
         hedging=true)

// ============================================================================
// INPUTS
// ============================================================================
grpFib = "=== Fibonacci Settings ==="
fibLevel1       = input.float(0.44, "Fib Level 1", minval=0.01, maxval=0.99, step=0.01, group=grpFib)
fibLevel2       = input.float(0.50, "Fib Level 2", minval=0.01, maxval=0.99, step=0.01, group=grpFib)
h22Lookback     = input.int(30, "22H Lookback Days", minval=5, maxval=60, group=grpFib)
overlapPips     = input.float(5.0, "Overlap Threshold (points)", minval=0.5, step=0.5, group=grpFib)

grpEma = "=== EMA Settings ==="
emaFastLen      = input.int(50, "EMA Fast Period", minval=5, group=grpEma)
emaSlowLen      = input.int(200, "EMA Slow Period", minval=50, group=grpEma)

grpST = "=== SuperTrend (Optional) ==="
useSuperTrend   = input.bool(true, "Enable SuperTrend", group=grpST)
stPeriod        = input.int(10, "SuperTrend ATR Period", minval=1, group=grpST)
stMultiplier    = input.float(3.0, "SuperTrend Multiplier", minval=0.1, step=0.1, group=grpST)

grpTrade = "=== Trade Settings ==="
lotSize         = input.float(1, "Lot Size per Leg", minval=0.01, step=0.01, group=grpTrade)
dailyCloseHr    = input.int(21, "Daily Close Hour (UTC)", minval=0, maxval=23, group=grpTrade)

grpRR = "=== Risk:Reward Profit Booking ==="
useRR           = input.bool(true, "Enable RR-based Profit Booking", group=grpRR)
rrRatio         = input.float(3.0, "Risk:Reward Ratio (1:X)", minval=1.0, step=0.5, group=grpRR)
rrRiskPts       = input.float(30.0, "Risk Reference (points) for RR calc", minval=1, step=1, group=grpRR)

grpLossHedge = "=== Loss Re-Hedge ==="
useLossRehedge  = input.bool(true, "Re-hedge when uni-trade in loss", group=grpLossHedge)
lossThreshPts   = input.float(20.0, "Loss Threshold (points) to trigger re-hedge", minval=1, step=1, group=grpLossHedge)

grpTrail = "=== Trailing Stop (Optional) ==="
useTrailing     = input.bool(false, "Enable Trailing Stop", group=grpTrail)
trailPoints     = input.float(30.0, "Trail Distance (points)", minval=1, step=1, group=grpTrail)
trailStartPts   = input.float(20.0, "Start Trail After (points)", minval=1, step=1, group=grpTrail)

grpDisp = "=== Display ==="
plotLevels      = input.bool(true, "Plot Fib Level Lines", group=grpDisp)
showDashboard   = input.bool(true, "Show Dashboard", group=grpDisp)
h22Color        = input.color(color.yellow, "22H Level Color", group=grpDisp)
s23Color        = input.color(color.orange, "23:00 Level Color", group=grpDisp)
s07Color        = input.color(color.aqua, "07:00 Level Color", group=grpDisp)
s12Color        = input.color(color.fuchsia, "12:00 Level Color", group=grpDisp)
overlapClr      = input.color(color.white, "Overlap Level Color", group=grpDisp)

// ============================================================================
// EMA CALCULATIONS
// ============================================================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)
plot(ema50,  "EMA 50",  color.new(color.blue, 0), 2)
plot(ema200, "EMA 200", color.new(color.yellow, 0), 2)

// ============================================================================
// SUPERTREND
// ============================================================================
[stLine, stDir] = ta.supertrend(stMultiplier, stPeriod)
stBullish = stDir < 0
stPlotClr = useSuperTrend ? (stBullish ? color.new(color.green, 60) : color.new(color.red, 60)) : na
plot(useSuperTrend ? stLine : na, "SuperTrend", stPlotClr, 2)

// ============================================================================
// 22-HOUR FIB LEVELS (from Daily candles as proxy)
// Using D timeframe: each daily candle approximates the 22H candle starting ~20:00 UTC
// ============================================================================
// We fetch daily high/low for the last N days
maxLevels = 120  // max fib levels to track

var float[] levelPrices = array.new_float(0)
var string[] levelSources = array.new_string(0)
var int[] levelConfidence = array.new_int(0)

// Recalculate levels once per day
newDay = ta.change(dayofweek) != 0

if newDay or barstate.isfirst
    // Clear arrays
    array.clear(levelPrices)
    array.clear(levelSources)
    array.clear(levelConfidence)

    // --- 22H Levels (from Daily) ---
    for i = 1 to h22Lookback
        dHigh = request.security(syminfo.tickerid, "D", high[i], lookahead=barmerge.lookahead_on)
        dLow  = request.security(syminfo.tickerid, "D", low[i], lookahead=barmerge.lookahead_on)
        dRange = dHigh - dLow
        if dRange > 0
            fib044 = dHigh - fibLevel1 * dRange
            fib050 = dHigh - fibLevel2 * dRange
            if array.size(levelPrices) < maxLevels
                array.push(levelPrices, fib044)
                array.push(levelSources, "H22")
                array.push(levelConfidence, 1)
                array.push(levelPrices, fib050)
                array.push(levelSources, "H22")
                array.push(levelConfidence, 1)

// ============================================================================
// SESSION LEVELS (from 30-min candles)
// ============================================================================
// Get 30-min data for session candles
[m30H, m30L, m30O, m30C, m30Time] = request.security(syminfo.tickerid, "30",
    [high, low, open, close, time], lookahead=barmerge.lookahead_on)

utcHour = hour(time, "UTC")
utcMin  = minute(time, "UTC")

// Track session level triggers
var bool got23 = false
var bool waiting23Red = false
var bool got07 = false
var bool got12 = false

// Reset daily
if newDay
    got23 := false
    waiting23Red := false
    got07 := false
    got12 := false

// 23:00 UTC - wait for first red 30min candle after
if utcHour == 23 and utcMin == 0 and not got23
    waiting23Red := true

if waiting23Red and utcHour >= 23 and not got23
    if m30C < m30O  // red candle on 30min
        m30Range = m30H - m30L
        if m30Range > 0
            fib044_23 = m30H - fibLevel1 * m30Range
            fib050_23 = m30H - fibLevel2 * m30Range
            if array.size(levelPrices) < maxLevels
                array.push(levelPrices, fib044_23)
                array.push(levelSources, "S23")
                array.push(levelConfidence, 1)
                array.push(levelPrices, fib050_23)
                array.push(levelSources, "S23")
                array.push(levelConfidence, 1)
            got23 := true
            waiting23Red := false

// 07:00 UTC candle
if utcHour == 7 and utcMin == 0 and not got07
    m30Range_07 = m30H - m30L
    if m30Range_07 > 0
        fib044_07 = m30H - fibLevel1 * m30Range_07
        fib050_07 = m30H - fibLevel2 * m30Range_07
        if array.size(levelPrices) < maxLevels
            array.push(levelPrices, fib044_07)
            array.push(levelSources, "S07")
            array.push(levelConfidence, 1)
            array.push(levelPrices, fib050_07)
            array.push(levelSources, "S07")
            array.push(levelConfidence, 1)
        got07 := true

// 12:00 UTC candle
if utcHour == 12 and utcMin == 0 and not got12
    m30Range_12 = m30H - m30L
    if m30Range_12 > 0
        fib044_12 = m30H - fibLevel1 * m30Range_12
        fib050_12 = m30H - fibLevel2 * m30Range_12
        if array.size(levelPrices) < maxLevels
            array.push(levelPrices, fib044_12)
            array.push(levelSources, "S12")
            array.push(levelConfidence, 1)
            array.push(levelPrices, fib050_12)
            array.push(levelSources, "S12")
            array.push(levelConfidence, 1)
        got12 := true

// ============================================================================
// OVERLAP DETECTION
// ============================================================================
if array.size(levelPrices) > 0
    for i = 0 to array.size(levelPrices) - 1
        array.set(levelConfidence, i, 1)

    for i = 0 to array.size(levelPrices) - 2
        for j = i + 1 to array.size(levelPrices) - 1
            if math.abs(array.get(levelPrices, i) - array.get(levelPrices, j)) <= overlapPips
                array.set(levelConfidence, i, array.get(levelConfidence, i) + 1)
                array.set(levelConfidence, j, array.get(levelConfidence, j) + 1)

// ============================================================================
// FIND NEAREST SUPPORT & RESISTANCE
// ============================================================================
var float nearestSup = na
var float nearestRes = na
var int   nearSupConf = 0
var int   nearResConf = 0

nearestSup := na
nearestRes := na
nearSupConf := 0
nearResConf := 0

if array.size(levelPrices) > 0
    minSupDist = 999999.0
    minResDist = 999999.0
    for i = 0 to array.size(levelPrices) - 1
        lvl = array.get(levelPrices, i)
        diff = lvl - close
        dist = math.abs(diff)
        if diff < 0 and dist < minSupDist
            minSupDist := dist
            nearestSup := lvl
            nearSupConf := array.get(levelConfidence, i)
        if diff >= 0 and dist < minResDist
            minResDist := dist
            nearestRes := lvl
            nearResConf := array.get(levelConfidence, i)

// ============================================================================
// PLOT LEVELS (up to 20 nearest)
// ============================================================================
// Pine has limited plot calls, so we use lines
var line[] levelLines = array.new_line(0)

// Clean old lines
if barstate.islast and plotLevels
    for i = 0 to array.size(levelLines) - 1
        line.delete(array.get(levelLines, i))
    array.clear(levelLines)

    // Draw levels
    plotCount = math.min(array.size(levelPrices), 40)
    for i = 0 to plotCount - 1
        lvl = array.get(levelPrices, i)
        src = array.get(levelSources, i)
        conf = array.get(levelConfidence, i)

        clr = h22Color
        if src == "S23"
            clr := s23Color
        else if src == "S07"
            clr := s07Color
        else if src == "S12"
            clr := s12Color

        w = 1
        if conf >= 2
            clr := overlapClr
            w := 2
        if conf >= 3
            w := 3

        l = line.new(bar_index - 100, lvl, bar_index + 10, lvl,
                     color=clr, width=w, style=line.style_dotted,
                     extend=extend.right)
        array.push(levelLines, l)

        // Label
        if i < 20  // limit labels
            lbl = label.new(bar_index + 5, lvl,
                           str.format("{0,number,#.##} ({1} x{2})", lvl, src, conf),
                           color=color.new(color.black, 80),
                           textcolor=clr, size=size.tiny, style=label.style_label_left)
            label.delete(lbl[1])

// ============================================================================
// HEDGE STRATEGY LOGIC
// ============================================================================
// State tracking
var int  hedgeState = 0      // 0=no pos, 1=buy only, 2=sell only, 3=full hedge
var bool dailyClosed = false
var float entryPriceBuy  = na  // track entry prices for RR calc
var float entryPriceSell = na
var int  rrBookings     = 0
var int  lossRehedges   = 0

// RR target in points
rrTarget = rrRiskPts * rrRatio

// Daily close to avoid swap
isDailyClose = utcHour == dailyCloseHr and utcMin == 0

if isDailyClose and not dailyClosed
    strategy.close_all(comment="Daily close - swap avoidance")
    hedgeState := 0
    entryPriceBuy  := na
    entryPriceSell := na
    dailyClosed := true

if utcHour != dailyCloseHr
    dailyClosed := false

// Price position relative to EMAs
aboveEma200 = close > ema200
ema50Above200 = ema50 > ema200
isBullish = aboveEma200 and ema50Above200
isBearish = not aboveEma200 and not ema50Above200

// Check if price is near any level
priceNearLevel = false
if array.size(levelPrices) > 0
    for i = 0 to array.size(levelPrices) - 1
        if math.abs(close - array.get(levelPrices, i)) <= overlapPips * 3
            priceNearLevel := true
            break

// Determine current position state
curBuyQty  = strategy.position_size > 0 ? strategy.position_size : 0
curSellQty = strategy.position_size < 0 ? math.abs(strategy.position_size) : 0

// Calculate leg profits in points
buyProfitPts  = not na(entryPriceBuy)  ? close - entryPriceBuy  : 0.0
sellProfitPts = not na(entryPriceSell) ? entryPriceSell - close : 0.0

// --- Entry: Open full hedge at level contact ---
if hedgeState == 0 and priceNearLevel and not isDailyClose
    strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Hedge BUY")
    strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Hedge SELL")
    entryPriceBuy  := close
    entryPriceSell := close
    hedgeState := 3

// --- Full hedge (2 positions): RR profit booking + losing leg exit ---
if hedgeState == 3
    // RR Profit Booking: close winner at 1:RR, re-hedge immediately
    if useRR
        if buyProfitPts >= rrTarget
            strategy.close("Hedge BUY", comment=str.format("RR 1:{0} BUY profit +{1,number,#.#}pts", rrRatio, buyProfitPts))
            rrBookings += 1
            // Re-open BUY to maintain hedge
            strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Re-hedge BUY after RR")
            entryPriceBuy := close

        if sellProfitPts >= rrTarget
            strategy.close("Hedge SELL", comment=str.format("RR 1:{0} SELL profit +{1,number,#.#}pts", rrRatio, sellProfitPts))
            rrBookings += 1
            // Re-open SELL to maintain hedge
            strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Re-hedge SELL after RR")
            entryPriceSell := close

    // At resistance → close losing BUY
    if not na(nearestRes) and close >= nearestRes - overlapPips
        if isBearish or (useSuperTrend and not stBullish)
            strategy.close("Hedge BUY", comment="Hit resistance, close BUY")
            entryPriceBuy := na
            hedgeState := 2

    // At support → close losing SELL
    if not na(nearestSup) and close <= nearestSup + overlapPips
        if isBullish or (useSuperTrend and stBullish)
            strategy.close("Hedge SELL", comment="Hit support, close SELL")
            entryPriceSell := na
            hedgeState := 1

// --- Uni-directional (1 position): loss re-hedge + RR booking + level re-hedge ---

// BUY only open
if hedgeState == 1 and not isDailyClose
    // A) Loss re-hedge: BUY losing beyond threshold → add SELL
    if useLossRehedge and buyProfitPts <= -lossThreshPts
        strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Loss re-hedge: BUY losing, add SELL")
        entryPriceSell := close
        lossRehedges += 1
        hedgeState := 3

    // B) RR profit booking on uni BUY → close + full re-hedge
    else if useRR and buyProfitPts >= rrTarget
        strategy.close("Hedge BUY", comment=str.format("RR 1:{0} uni-BUY booked +{1,number,#.#}pts", rrRatio, buyProfitPts))
        rrBookings += 1
        strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Re-hedge BUY")
        strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Re-hedge SELL")
        entryPriceBuy  := close
        entryPriceSell := close
        hedgeState := 3

    // C) Level-based re-hedge
    else if not na(nearestSup) and close < nearestSup
        strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Re-hedge SELL (below support)")
        entryPriceSell := close
        hedgeState := 3
    else if isBearish
        strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Re-hedge SELL (EMA bearish)")
        entryPriceSell := close
        hedgeState := 3

// SELL only open
if hedgeState == 2 and not isDailyClose
    // A) Loss re-hedge: SELL losing beyond threshold → add BUY
    if useLossRehedge and sellProfitPts <= -lossThreshPts
        strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Loss re-hedge: SELL losing, add BUY")
        entryPriceBuy := close
        lossRehedges += 1
        hedgeState := 3

    // B) RR profit booking on uni SELL → close + full re-hedge
    else if useRR and sellProfitPts >= rrTarget
        strategy.close("Hedge SELL", comment=str.format("RR 1:{0} uni-SELL booked +{1,number,#.#}pts", rrRatio, sellProfitPts))
        rrBookings += 1
        strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Re-hedge BUY")
        strategy.entry("Hedge SELL", strategy.short, qty=lotSize, comment="Re-hedge SELL")
        entryPriceBuy  := close
        entryPriceSell := close
        hedgeState := 3

    // C) Level-based re-hedge
    else if not na(nearestRes) and close > nearestRes
        strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Re-hedge BUY (above resist)")
        entryPriceBuy := close
        hedgeState := 3
    else if isBullish
        strategy.entry("Hedge BUY", strategy.long, qty=lotSize, comment="Re-hedge BUY (EMA bullish)")
        entryPriceBuy := close
        hedgeState := 3

// ============================================================================
// TRAILING STOP
// ============================================================================
if useTrailing and strategy.position_size != 0
    if strategy.position_size > 0
        trailSL = close - trailPoints
        if close - strategy.position_avg_price >= trailStartPts
            strategy.exit("Trail BUY", "Hedge BUY", stop=trailSL)
    if strategy.position_size < 0
        trailSL = close + trailPoints
        if strategy.position_avg_price - close >= trailStartPts
            strategy.exit("Trail SELL", "Hedge SELL", stop=trailSL)

// ============================================================================
// SIGNAL ARROWS
// ============================================================================
buySignal  = hedgeState == 0 and priceNearLevel and aboveEma200
sellSignal = hedgeState == 0 and priceNearLevel and not aboveEma200

plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// ============================================================================
// DASHBOARD TABLE
// ============================================================================
if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 20, bgcolor=color.new(color.black, 85),
                               border_width=1, border_color=color.gray)

    table.cell(dash, 0, 0, "GOLD FIB HEDGE", text_color=color.yellow, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // P&L
    pnl = strategy.netprofit
    pnlClr = pnl >= 0 ? color.lime : color.red
    table.cell(dash, 0, 1, "Net P&L", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(pnl, "#.##"), text_color=pnlClr, text_size=size.small)

    openPnL = strategy.openprofit
    opClr = openPnL >= 0 ? color.lime : color.red
    table.cell(dash, 0, 2, "Open P&L", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(openPnL, "#.##"), text_color=opClr, text_size=size.small)

    // Lot Size
    table.cell(dash, 0, 3, "Lot Size", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(lotSize, "#.##"), text_color=color.white, text_size=size.small)

    // Position
    table.cell(dash, 0, 4, "Position", text_color=color.silver, text_size=size.small)
    posText = hedgeState == 3 ? "FULL HEDGE" : hedgeState == 1 ? "BUY ONLY" : hedgeState == 2 ? "SELL ONLY" : "FLAT"
    posClr = hedgeState == 3 ? color.yellow : hedgeState == 1 ? color.lime : hedgeState == 2 ? color.red : color.gray
    table.cell(dash, 1, 4, posText, text_color=posClr, text_size=size.small)

    // Leg profit in points
    table.cell(dash, 0, 5, "BUY Profit", text_color=color.silver, text_size=size.small)
    bpClr = buyProfitPts >= 0 ? color.lime : color.red
    table.cell(dash, 1, 5, not na(entryPriceBuy) ? str.tostring(buyProfitPts, "#.#") + " pts" : "---", text_color=bpClr, text_size=size.small)

    table.cell(dash, 0, 6, "SELL Profit", text_color=color.silver, text_size=size.small)
    spClr = sellProfitPts >= 0 ? color.lime : color.red
    table.cell(dash, 1, 6, not na(entryPriceSell) ? str.tostring(sellProfitPts, "#.#") + " pts" : "---", text_color=spClr, text_size=size.small)

    // RR & Loss Re-hedge stats
    table.cell(dash, 0, 7, "RR Ratio", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, "1:" + str.tostring(rrRatio, "#.#") + " (risk " + str.tostring(rrRiskPts, "#") + "pts)", text_color=color.aqua, text_size=size.small)

    table.cell(dash, 0, 8, "RR Bookings", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(rrBookings), text_color=color.aqua, text_size=size.small)

    table.cell(dash, 0, 9, "Loss Re-hedges", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(lossRehedges), text_color=color.orange, text_size=size.small)

    // Nearest levels
    table.cell(dash, 0, 10, "Next Resist", text_color=color.silver, text_size=size.small)
    resText = not na(nearestRes) ? str.tostring(nearestRes, "#.##") + " [x" + str.tostring(nearResConf) + "]" : "---"
    table.cell(dash, 1, 10, resText, text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 11, "Next Support", text_color=color.silver, text_size=size.small)
    supText = not na(nearestSup) ? str.tostring(nearestSup, "#.##") + " [x" + str.tostring(nearSupConf) + "]" : "---"
    table.cell(dash, 1, 11, supText, text_color=color.lime, text_size=size.small)

    // Trades
    table.cell(dash, 0, 12, "Total Trades", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(strategy.closedtrades + strategy.opentrades), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 13, "Win Rate", text_color=color.silver, text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(dash, 1, 13, str.tostring(winRate, "#.#") + "%", text_color=color.white, text_size=size.small)

    // Trend
    trendText = isBullish ? "BULLISH" : isBearish ? "BEARISH" : "MIXED"
    trendClr = isBullish ? color.lime : isBearish ? color.red : color.orange
    table.cell(dash, 0, 14, "Trend", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 14, trendText, text_color=trendClr, text_size=size.small)

    // EMA info
    table.cell(dash, 0, 15, "EMA 50 / 200", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 15, str.tostring(ema50, "#.##") + " / " + str.tostring(ema200, "#.##"), text_color=color.white, text_size=size.tiny)

    // SuperTrend
    if useSuperTrend
        table.cell(dash, 0, 16, "SuperTrend", text_color=color.silver, text_size=size.small)
        stText = stBullish ? "BULL" : "BEAR"
        table.cell(dash, 1, 16, str.tostring(stLine, "#.##") + " " + stText,
                   text_color=stBullish ? color.lime : color.red, text_size=size.small)

    // Level counts
    h22c = 0
    s23c = 0
    s07c = 0
    s12c = 0
    if array.size(levelSources) > 0
        for i = 0 to array.size(levelSources) - 1
            src = array.get(levelSources, i)
            if src == "H22"
                h22c += 1
            else if src == "S23"
                s23c += 1
            else if src == "S07"
                s07c += 1
            else if src == "S12"
                s12c += 1

    table.cell(dash, 0, 17, "Levels", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 17, str.tostring(array.size(levelPrices)), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 18, "Breakdown", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 18, "22H:" + str.tostring(h22c) + " 23:" + str.tostring(s23c) +
               " 07:" + str.tostring(s07c) + " 12:" + str.tostring(s12c),
               text_color=color.gray, text_size=size.tiny)

    // Max drawdown
    table.cell(dash, 0, 19, "Max DD", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 19, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.red, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(buySignal,  "GFH Buy Signal",  "Gold Fib Hedge: BUY signal at {{close}}")
alertcondition(sellSignal, "GFH Sell Signal", "Gold Fib Hedge: SELL signal at {{close}}")
alertcondition(isDailyClose, "GFH Daily Close", "Gold Fib Hedge: Daily close triggered")
