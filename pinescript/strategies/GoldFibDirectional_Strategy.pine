//@version=5
strategy("Gold Fib Directional Strategy", shorttitle="GFD Strategy",
         overlay=true, default_qty_type=strategy.fixed,
         default_qty_value=1, initial_capital=10000, currency=currency.USD,
         commission_type=strategy.commission.percent, commission_value=0.01,
         slippage=3, calc_on_every_tick=false, pyramiding=1)

// ============================================================================
// INPUTS
// ============================================================================
grpFib = "=== Fibonacci Settings ==="
fibLevel1       = input.float(0.44, "Fib Level 1", minval=0.01, maxval=0.99, step=0.01, group=grpFib)
fibLevel2       = input.float(0.50, "Fib Level 2", minval=0.01, maxval=0.99, step=0.01, group=grpFib)
h22Lookback     = input.int(30, "22H Lookback Days", minval=5, maxval=60, group=grpFib)
overlapPts      = input.float(5.0, "Overlap Threshold (points)", minval=0.5, step=0.5, group=grpFib)
levelProximity  = input.float(15.0, "Level Proximity for Entry (points)", minval=1, step=1, group=grpFib)

grpEma = "=== EMA Settings ==="
emaFastLen      = input.int(50, "EMA Fast Period", minval=5, group=grpEma)
emaSlowLen      = input.int(200, "EMA Slow Period", minval=50, group=grpEma)

grpST = "=== SuperTrend (Optional) ==="
useST           = input.bool(true, "Enable SuperTrend", group=grpST)
stPeriod        = input.int(10, "SuperTrend ATR Period", minval=1, group=grpST)
stMult          = input.float(3.0, "SuperTrend Multiplier", minval=0.1, step=0.1, group=grpST)

grpTrade = "=== Trade Settings ==="
lotSize         = input.float(1, "Position Size", minval=0.01, step=0.01, group=grpTrade)
dailyCloseHr    = input.int(21, "Daily Close Hour (UTC)", minval=0, maxval=23, group=grpTrade)
cooldownBars    = input.int(10, "Cooldown Bars After Exit", minval=1, maxval=100, group=grpTrade)

grpSL = "=== Stop Loss ==="
slMode          = input.string("SuperTrend", "SL Mode", options=["SuperTrend", "Fixed Pips", "Previous Level"], group=grpSL)
fixedSL         = input.float(50.0, "Fixed SL (points)", minval=1, step=1, group=grpSL)

grpTP = "=== Take Profit ==="
tpMode          = input.string("Next Level", "TP Mode", options=["Next Level", "Fixed Pips", "RR Ratio"], group=grpTP)
fixedTP         = input.float(100.0, "Fixed TP (points)", minval=1, step=1, group=grpTP)
rrRatio         = input.float(2.0, "Risk:Reward Ratio", minval=0.5, step=0.1, group=grpTP)

grpTrail = "=== Trailing Stop (Optional) ==="
useTrail        = input.bool(false, "Enable Trailing Stop", group=grpTrail)
trailPts        = input.float(30.0, "Trail Distance (points)", minval=1, step=1, group=grpTrail)
trailStart      = input.float(20.0, "Start Trail After (points profit)", minval=1, step=1, group=grpTrail)

grpDisp = "=== Display ==="
plotLevels      = input.bool(true, "Plot Fib Level Lines", group=grpDisp)
showDashboard   = input.bool(true, "Show Dashboard", group=grpDisp)
h22Color        = input.color(color.yellow, "22H Level Color", group=grpDisp)
s23Color        = input.color(color.orange, "23:00 Level Color", group=grpDisp)
s07Color        = input.color(color.aqua, "07:00 Level Color", group=grpDisp)
s12Color        = input.color(color.fuchsia, "12:00 Level Color", group=grpDisp)
overlapClr      = input.color(color.white, "Overlap Level Color", group=grpDisp)

// ============================================================================
// EMA
// ============================================================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)
plot(ema50,  "EMA 50",  color.new(color.blue, 0), 2)
plot(ema200, "EMA 200", color.new(color.yellow, 0), 2)

bullishTrend = close > ema200 and ema50 > ema200
bearishTrend = close < ema200 and ema50 < ema200

// EMA cross detection
emaCrossBull = ta.crossover(ema50, ema200)
emaCrossDown = ta.crossunder(ema50, ema200)

// ============================================================================
// SUPERTREND
// ============================================================================
[stLine, stDir] = ta.supertrend(stMult, stPeriod)
stBullish = stDir < 0
stFlipBull = stDir < 0 and stDir[1] >= 0
stFlipBear = stDir >= 0 and stDir[1] < 0

stPlotClr = useST ? (stBullish ? color.new(color.green, 60) : color.new(color.red, 60)) : na
plot(useST ? stLine : na, "SuperTrend", stPlotClr, 2)

// ============================================================================
// FIB LEVEL ARRAYS
// ============================================================================
maxLvl = 120
var float[]  lvlPrices  = array.new_float(0)
var string[] lvlSources = array.new_string(0)
var int[]    lvlConf    = array.new_int(0)

newDay = ta.change(dayofweek) != 0

if newDay or barstate.isfirst
    array.clear(lvlPrices)
    array.clear(lvlSources)
    array.clear(lvlConf)

    // 22H levels from Daily
    for i = 1 to h22Lookback
        dH = request.security(syminfo.tickerid, "D", high[i], lookahead=barmerge.lookahead_on)
        dL = request.security(syminfo.tickerid, "D", low[i],  lookahead=barmerge.lookahead_on)
        rng = dH - dL
        if rng > 0 and array.size(lvlPrices) < maxLvl
            array.push(lvlPrices, dH - fibLevel1 * rng)
            array.push(lvlSources, "H22")
            array.push(lvlConf, 1)
            array.push(lvlPrices, dH - fibLevel2 * rng)
            array.push(lvlSources, "H22")
            array.push(lvlConf, 1)

// ============================================================================
// SESSION LEVELS
// ============================================================================
[m30H, m30L, m30O, m30C, m30T] = request.security(syminfo.tickerid, "30",
    [high, low, open, close, time], lookahead=barmerge.lookahead_on)

utcHr  = hour(time, "UTC")
utcMn  = minute(time, "UTC")

var bool got23 = false
var bool wait23 = false
var bool got07 = false
var bool got12 = false

if newDay
    got23  := false
    wait23 := false
    got07  := false
    got12  := false

if utcHr == 23 and utcMn == 0 and not got23
    wait23 := true

if wait23 and utcHr >= 23 and not got23
    if m30C < m30O
        rng23 = m30H - m30L
        if rng23 > 0 and array.size(lvlPrices) < maxLvl
            array.push(lvlPrices, m30H - fibLevel1 * rng23)
            array.push(lvlSources, "S23")
            array.push(lvlConf, 1)
            array.push(lvlPrices, m30H - fibLevel2 * rng23)
            array.push(lvlSources, "S23")
            array.push(lvlConf, 1)
            got23  := true
            wait23 := false

if utcHr == 7 and utcMn == 0 and not got07
    rng07 = m30H - m30L
    if rng07 > 0 and array.size(lvlPrices) < maxLvl
        array.push(lvlPrices, m30H - fibLevel1 * rng07)
        array.push(lvlSources, "S07")
        array.push(lvlConf, 1)
        array.push(lvlPrices, m30H - fibLevel2 * rng07)
        array.push(lvlSources, "S07")
        array.push(lvlConf, 1)
        got07 := true

if utcHr == 12 and utcMn == 0 and not got12
    rng12 = m30H - m30L
    if rng12 > 0 and array.size(lvlPrices) < maxLvl
        array.push(lvlPrices, m30H - fibLevel1 * rng12)
        array.push(lvlSources, "S12")
        array.push(lvlConf, 1)
        array.push(lvlPrices, m30H - fibLevel2 * rng12)
        array.push(lvlSources, "S12")
        array.push(lvlConf, 1)
        got12 := true

// ============================================================================
// OVERLAP DETECTION
// ============================================================================
if array.size(lvlPrices) > 0
    for i = 0 to array.size(lvlPrices) - 1
        array.set(lvlConf, i, 1)
    for i = 0 to array.size(lvlPrices) - 2
        for j = i + 1 to array.size(lvlPrices) - 1
            if math.abs(array.get(lvlPrices, i) - array.get(lvlPrices, j)) <= overlapPts
                array.set(lvlConf, i, array.get(lvlConf, i) + 1)
                array.set(lvlConf, j, array.get(lvlConf, j) + 1)

// ============================================================================
// NEAREST LEVELS (sorted)
// ============================================================================
var float nearSup = na
var float nearRes = na
var int   nearSupC = 0
var int   nearResC = 0
var float nextSup = na    // 2nd nearest support
var float nextRes = na    // 2nd nearest resistance

nearSup  := na
nearRes  := na
nextSup  := na
nextRes  := na
nearSupC := 0
nearResC := 0

if array.size(lvlPrices) > 0
    // Find two nearest supports and resistances
    bestSupDist  = 999999.0
    bestSup2Dist = 999999.0
    bestResDist  = 999999.0
    bestRes2Dist = 999999.0

    for i = 0 to array.size(lvlPrices) - 1
        lvl  = array.get(lvlPrices, i)
        diff = lvl - close
        dist = math.abs(diff)

        if diff < 0  // support
            if dist < bestSupDist
                bestSup2Dist := bestSupDist
                nextSup      := nearSup
                bestSupDist  := dist
                nearSup      := lvl
                nearSupC     := array.get(lvlConf, i)
            else if dist < bestSup2Dist
                bestSup2Dist := dist
                nextSup      := lvl

        else  // resistance
            if dist < bestResDist
                bestRes2Dist := bestResDist
                nextRes      := nearRes
                bestResDist  := dist
                nearRes      := lvl
                nearResC     := array.get(lvlConf, i)
            else if dist < bestRes2Dist
                bestRes2Dist := dist
                nextRes      := lvl

// ============================================================================
// PLOT LEVELS
// ============================================================================
var line[]  lvlLines  = array.new_line(0)
var label[] lvlLabels = array.new_label(0)

if barstate.islast and plotLevels
    for i = 0 to array.size(lvlLines) - 1
        line.delete(array.get(lvlLines, i))
    array.clear(lvlLines)
    for i = 0 to array.size(lvlLabels) - 1
        label.delete(array.get(lvlLabels, i))
    array.clear(lvlLabels)

    cnt = math.min(array.size(lvlPrices), 40)
    for i = 0 to cnt - 1
        lvl  = array.get(lvlPrices, i)
        src  = array.get(lvlSources, i)
        conf = array.get(lvlConf, i)

        clr = h22Color
        if src == "S23"
            clr := s23Color
        else if src == "S07"
            clr := s07Color
        else if src == "S12"
            clr := s12Color

        w = 1
        if conf >= 2
            clr := overlapClr
            w := 2
        if conf >= 3
            w := 3

        ln = line.new(bar_index - 80, lvl, bar_index + 10, lvl,
                      color=clr, width=w, style=line.style_dotted, extend=extend.right)
        array.push(lvlLines, ln)

        if i < 20
            lb = label.new(bar_index + 5, lvl,
                          str.format("{0,number,#.##} ({1} x{2})", lvl, src, conf),
                          color=color.new(color.black, 80), textcolor=clr,
                          size=size.tiny, style=label.style_label_left)
            array.push(lvlLabels, lb)

// ============================================================================
// STRATEGY LOGIC
// ============================================================================
var int barsSinceExit = 999

// Daily close
isDailyClose = utcHr == dailyCloseHr and utcMn == 0
var bool dailyClosed = false

if isDailyClose and not dailyClosed and strategy.position_size != 0
    strategy.close_all(comment="Daily close")
    barsSinceExit := 0
    dailyClosed   := true

if utcHr != dailyCloseHr
    dailyClosed := false

// Cooldown tracking
if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0

barsSinceExit += 1

// Candle confirmation
bullCandle = close > open
bearCandle = close < open

// Entry proximity check
nearSupport = not na(nearSup) and (close - nearSup) >= 0 and (close - nearSup) <= levelProximity
nearResistance = not na(nearRes) and (nearRes - close) >= 0 and (nearRes - close) <= levelProximity

// --- SL calculation ---
calcSL_buy  = slMode == "SuperTrend" and useST ? stLine : slMode == "Previous Level" and not na(nextSup) ? nextSup : close - fixedSL
calcSL_sell = slMode == "SuperTrend" and useST ? stLine : slMode == "Previous Level" and not na(nextRes) ? nextRes : close + fixedSL

// --- TP calculation ---
calcTP_buy  = tpMode == "Next Level" and not na(nearRes) ? nearRes : tpMode == "RR Ratio" ? close + math.abs(close - calcSL_buy) * rrRatio : close + fixedTP
calcTP_sell = tpMode == "Next Level" and not na(nearSup) ? nearSup : tpMode == "RR Ratio" ? close - math.abs(calcSL_sell - close) * rrRatio : close - fixedTP

// --- BUY ENTRY ---
buyEntry = bullishTrend and nearSupport and bullCandle and close > nearSup
           and barsSinceExit >= cooldownBars and not isDailyClose
           and strategy.position_size == 0
           and (not useST or stBullish)

// --- SELL ENTRY ---
sellEntry = bearishTrend and nearResistance and bearCandle and close < nearRes
            and barsSinceExit >= cooldownBars and not isDailyClose
            and strategy.position_size == 0
            and (not useST or not stBullish)

if buyEntry
    strategy.entry("Buy", strategy.long, qty=lotSize, comment="Buy @sup")
    strategy.exit("Buy Exit", "Buy", stop=calcSL_buy, limit=calcTP_buy)

if sellEntry
    strategy.entry("Sell", strategy.short, qty=lotSize, comment="Sell @res")
    strategy.exit("Sell Exit", "Sell", stop=calcSL_sell, limit=calcTP_sell)

// --- EMA CROSS EXIT ---
if strategy.position_size > 0 and emaCrossDown
    strategy.close("Buy", comment="EMA cross bearish")

if strategy.position_size < 0 and emaCrossBull
    strategy.close("Sell", comment="EMA cross bullish")

// --- SUPERTREND FLIP EXIT ---
if useST and strategy.position_size > 0 and stFlipBear
    strategy.close("Buy", comment="ST flip bearish")

if useST and strategy.position_size < 0 and stFlipBull
    strategy.close("Sell", comment="ST flip bullish")

// --- TRAILING STOP ---
if useTrail and strategy.position_size > 0
    if close - strategy.position_avg_price >= trailStart
        strategy.exit("Trail Buy", "Buy", trail_points=trailPts, trail_offset=trailPts)

if useTrail and strategy.position_size < 0
    if strategy.position_avg_price - close >= trailStart
        strategy.exit("Trail Sell", "Sell", trail_points=trailPts, trail_offset=trailPts)

// ============================================================================
// SIGNAL MARKERS
// ============================================================================
plotshape(buyEntry,  "Buy",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(sellEntry, "Sell", shape.triangledown,  location.abovebar, color.red,  size=size.small)

// Mark nearest S/R on bars
bgcolor(nearSupport ? color.new(color.green, 92) : na, title="Near Support")
bgcolor(nearResistance ? color.new(color.red, 92) : na, title="Near Resistance")

// ============================================================================
// DASHBOARD
// ============================================================================
if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 18, bgcolor=color.new(color.black, 85),
                               border_width=1, border_color=color.gray)

    table.cell(dash, 0, 0, "GOLD FIB DIRECTIONAL", text_color=color.yellow, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Net P&L
    pnl = strategy.netprofit
    pClr = pnl >= 0 ? color.lime : color.red
    table.cell(dash, 0, 1, "Net P&L", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(pnl, "#.##"), text_color=pClr, text_size=size.small)

    // Open P&L
    opnl = strategy.openprofit
    oClr = opnl >= 0 ? color.lime : color.red
    table.cell(dash, 0, 2, "Open P&L", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(opnl, "#.##"), text_color=oClr, text_size=size.small)

    // Position
    posText = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posClr  = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 0, 3, "Position", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, posText + " (" + str.tostring(math.abs(strategy.position_size), "#.##") + ")", text_color=posClr, text_size=size.small)

    // Lot size
    table.cell(dash, 0, 4, "Lot Size", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(lotSize, "#.##"), text_color=color.white, text_size=size.small)

    // Nearest S/R
    table.cell(dash, 0, 5, "Next Resist", text_color=color.silver, text_size=size.small)
    rTxt = not na(nearRes) ? str.tostring(nearRes, "#.##") + " [x" + str.tostring(nearResC) + "]" : "---"
    table.cell(dash, 1, 5, rTxt, text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 6, "Next Support", text_color=color.silver, text_size=size.small)
    sTxt = not na(nearSup) ? str.tostring(nearSup, "#.##") + " [x" + str.tostring(nearSupC) + "]" : "---"
    table.cell(dash, 1, 6, sTxt, text_color=color.lime, text_size=size.small)

    // 2nd levels
    table.cell(dash, 0, 7, "2nd Resist", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, not na(nextRes) ? str.tostring(nextRes, "#.##") : "---", text_color=color.new(color.red, 40), text_size=size.small)

    table.cell(dash, 0, 8, "2nd Support", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, not na(nextSup) ? str.tostring(nextSup, "#.##") : "---", text_color=color.new(color.green, 40), text_size=size.small)

    // Trades
    totalT = strategy.closedtrades + strategy.opentrades
    table.cell(dash, 0, 9, "Total Trades", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(totalT), text_color=color.white, text_size=size.small)

    // Count longs and shorts from closed trades
    longC  = 0
    shortC = 0
    for i = 0 to strategy.closedtrades - 1
        if strategy.closedtrades.size(i) > 0
            longC += 1
        else
            shortC += 1

    table.cell(dash, 0, 10, "Buy / Sell", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(longC) + " / " + str.tostring(shortC), text_color=color.white, text_size=size.small)

    // Win rate
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0
    table.cell(dash, 0, 11, "Win Rate", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 11, str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.lime : color.orange, text_size=size.small)

    // Profit factor
    pf = strategy.closedtrades > 0 ? strategy.grossprofit / math.max(math.abs(strategy.grossloss), 0.01) : 0
    table.cell(dash, 0, 12, "Profit Factor", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(pf, "#.##"), text_color=pf >= 1 ? color.lime : color.red, text_size=size.small)

    // EMA / Trend
    trendTxt = bullishTrend ? "BULLISH" : bearishTrend ? "BEARISH" : "MIXED"
    trendClr = bullishTrend ? color.lime : bearishTrend ? color.red : color.orange
    table.cell(dash, 0, 13, "Trend", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 13, trendTxt, text_color=trendClr, text_size=size.small)

    table.cell(dash, 0, 14, "EMA 50 / 200", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 14, str.tostring(ema50, "#.##") + " / " + str.tostring(ema200, "#.##"), text_color=color.white, text_size=size.tiny)

    // SuperTrend
    if useST
        table.cell(dash, 0, 15, "SuperTrend", text_color=color.silver, text_size=size.small)
        table.cell(dash, 1, 15, str.tostring(stLine, "#.##") + (stBullish ? " BULL" : " BEAR"),
                   text_color=stBullish ? color.lime : color.red, text_size=size.small)

    // SL/TP modes
    table.cell(dash, 0, 16, "SL / TP", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 16, slMode + " / " + tpMode, text_color=color.gray, text_size=size.tiny)

    // Level counts
    h22c = 0
    s23c = 0
    s07c = 0
    s12c = 0
    if array.size(lvlSources) > 0
        for i = 0 to array.size(lvlSources) - 1
            s = array.get(lvlSources, i)
            if s == "H22"
                h22c += 1
            else if s == "S23"
                s23c += 1
            else if s == "S07"
                s07c += 1
            else if s == "S12"
                s12c += 1

    table.cell(dash, 0, 17, "Levels", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 17, "22H:" + str.tostring(h22c) + " 23:" + str.tostring(s23c) +
               " 07:" + str.tostring(s07c) + " 12:" + str.tostring(s12c),
               text_color=color.gray, text_size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(buyEntry,    "GFD Buy Entry",   "Gold Fib Directional: BUY at {{close}}")
alertcondition(sellEntry,   "GFD Sell Entry",  "Gold Fib Directional: SELL at {{close}}")
alertcondition(isDailyClose,"GFD Daily Close", "Gold Fib Directional: Daily close")
alertcondition(emaCrossBull,"GFD EMA Bull Cross", "EMA 50 crossed above EMA 200")
alertcondition(emaCrossDown,"GFD EMA Bear Cross", "EMA 50 crossed below EMA 200")
