{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Market Sentiment Dashboard",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3", "run.py"],
      "cwd": "apps/dashboards/market_sentiment",
      "port": 8000
    },
    {
      "name": "Stock Scanner",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3", "start.py"],
      "cwd": "apps/dashboards/stock_scanner",
      "port": 8001
    },
    {
      "name": "Backtester",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3", "run.py"],
      "cwd": "apps/tools/backtester",
      "port": 8002
    },
    {
      "name": "trading-dashboard-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "apps/dashboards/trading_dashboard/frontend",
      "port": 3000
    },
    {
      "name": "Rey Capital AI Bot",
      "runtimeExecutable": "python",
      "runtimeArgs": ["run.py", "--mode", "paper"],
      "cwd": "shared/execution/execution/gemma_trader",
      "port": 8050,
      "autoPort": true
    }
  ]
}
